{
  "name": "miulist-desktop",
  "private": true,
  "version": "1.0.10",
  "type": "module",
  "description": "MiuList 桌面网页端：单文件静态前端 + 本机 JSON 快照",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "tsc --noEmit && vite build && node scripts/finish-build.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
