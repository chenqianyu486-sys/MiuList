<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下的自动备份规则：**全部排除**。

  为什么全排：Auto Backup 会把 App 私有目录原样上传到用户的 Google 账号，
  而这个 App 的私有目录里装的是**课表、考场、座位号、待办、作业标题**，
  还有用户自己挑的**壁纸照片**。这些东西用户没有一条是打算公开的，
  而「用户没主动上传」与「数据离机」不是一回事。

  所以这里不挑着排 —— 五个域全排，凭据那份再单独写一遍。

  **代价要知道**：换机、重装之后系统不会自动把数据搬过来。
  跨设备靠 App 自带的「导出快照 / 导入快照」（JSON 文件，用户自己选位置）。
  这是有意的取舍：要的是「数据默认不离开设备」，而不是「数据自动跟着走」。

  凭据安全：即便将来有人收窄上面的排除范围，这一行也不许删。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="sharedpref" path="miulist_secure_credentials.xml" />
</full-backup-content>
