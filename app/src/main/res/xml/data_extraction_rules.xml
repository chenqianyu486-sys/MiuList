<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 凭据安全：绝不将硬件加密密钥派生的凭据配置上传到云端备份 -->
        <exclude domain="sharedpref" path="miulist_secure_credentials.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="miulist_secure_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>
