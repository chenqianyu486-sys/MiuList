<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层：纸感暖白（左上 #F8F6F0 → 右下 #ECE8DB）。

  端点必须与 .tmp/make_launcher_icons.py 里的 PAPER_TL / PAPER_BR 一致：
  前景 PNG 只画插画本身，画布其余部分透明，露出来的就是这个底色，
  两边不同色会在插画四周看出接缝。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF8F6F0" />
                <item android:offset="1.0" android:color="#FFECE8DB" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
