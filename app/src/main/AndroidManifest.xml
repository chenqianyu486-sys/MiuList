<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 「ZJU」导入源要在 App 内直接登录教务网取课表。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        本地提醒。**没有推送 SDK、没有云端消息服务**：提醒时刻与内容全部在本机
        用 AlarmManager 计算并触发。

        · POST_NOTIFICATIONS：Android 13+ 发通知的运行时权限；
        · SCHEDULE_EXACT_ALARM：Android 12+ 的精确闹钟特殊权限。用户没给时
          自动退到不精确闹钟（可能迟到几分钟），不会因此崩溃；
        · RECEIVE_BOOT_COMPLETED：重启后把还没响的提醒重新注册一遍。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MiuListApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <!--
                键盘策略必须是 adjustResize，不能用默认的 adjustPan。

                adjustPan 的做法是「键盘挡上来时把整个窗口往上平移」，
                挪到输入框露出来为止。本 App 是 edge-to-edge 的：窗口铺满整屏、
                顶栏自己避让状态栏（windowInsetsPadding(topSafeArea)）。
                窗口一平移，**整页内容跟着往上跑**，顶栏就从状态栏底下钻了出来 ——
                实测顶栏行从 y=0 变成 y=-109px，正好顶在时钟与电量图标上。
                用户看到的不是「顶栏没避让刘海」，而是「状态栏压在标题上」。

                adjustResize 不平移窗口：键盘弹起时窗口高度变短（或 edge-to-edge 下
                直接把键盘高度作为 ime inset 发下来），顶栏原地不动。
                弹层那侧由 [GlassBottomSheetHost] 负责避让键盘（safeDrawing 含 ime）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            本地提醒唯一的接收器。**不导出**：闹钟是显式 PendingIntent（指名到它），
            开机 / 改时间这些是系统受保护广播，两者都不需要对外露出入口。

            开机与改时间是「重新注册」而不是「补发」：错过的提醒不再弹，
            只按当下的数据排未来。补发一堆已经过时的事只会添乱。
        -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
