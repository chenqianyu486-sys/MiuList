*.iml
.gradle
.kotlin
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
.env
debug.keystore

# --- 密钥与凭据：绝不允许进版本库 ---
# release 上传密钥。app/build.gradle.kts 的 release signingConfig 指向
# ${rootDir}/my-upload-key.jks，一旦生成，没这几行就会被 `git add .` 直接收进去。
my-upload-key.jks
*.jks
*.keystore
*.p12
*.pem
*.ppk
*.bks
keystore.properties
secrets.properties
# Firebase / Google Services 配置文件（内含 API key 与 project 信息）。
google-services.json
# 环境变量派生文件。上面已忽略精确名 `.env`，这里补上 .env.local / .env.production 等；
# 用 ! 把占位模板 .env.example 放回来，它需要被跟踪。
.env.*
!.env.example

# --- 调试产物：截图、录屏、uiautomator dump ---
# 对比配色和抓交互时留下的中间产物，不是源码，也不是要发布的资源。
# 全部锚到仓库根目录，避免误伤 app/src 下的同名文件。
.shots/
/_shots/
/*.mp4
/window_dump*.xml
/ui.xml
/test_screen.png
# 本地跑 Gradle 时重定向出来的日志（testDebugUnitTest 输出等），不是源码也不是报告。
/*.log

# Python
__pycache__/
*.py[cod]
*$py.class

# --- 设计工作笔记本：本地留存，不进版本库 ---
# 约 21MB 的基线/对比截图、数据库快照、prefs 导出，外加 20 个
# 「用 Python 改 Kotlin 源码」的一次性 patch 脚本。
# 后者尤其不该公开：别人 clone 下来误跑一次就会把源码改坏。
design/

